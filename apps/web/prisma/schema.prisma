generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String?        @unique
  passwordHash String?
  guestToken   String?        @unique
  rating       Int            @default(1000)
  wins         Int            @default(0)
  losses       Int            @default(0)
  draws        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  matchPlayers MatchPlayer[]

  @@index([rating(sort: Desc)])
  @@index([guestToken])
}

model Match {
  id           String        @id @default(cuid())
  mode         GameMode
  status       MatchStatus   @default(WAITING)
  roomCode     String?       @unique
  boardRows    Int           @default(8)
  boardCols    Int           @default(12)
  totalTurns   Int           @default(0)
  winnerId     String?
  difficulty   Difficulty?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  players      MatchPlayer[]
  moves        Move[]

  @@index([status])
  @@index([roomCode])
  @@index([createdAt(sort: Desc)])
}

model MatchPlayer {
  id        String      @id @default(cuid())
  matchId   String
  userId    String
  color     Int
  isBot     Boolean     @default(false)
  isAlive   Boolean     @default(true)
  joinedAt  DateTime    @default(now())
  match     Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@unique([matchId, color])
  @@index([userId])
}

model Move {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  row       Int
  col       Int
  turnNum   Int
  timestamp DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, turnNum])
}

model Leaderboard {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  wins      Int      @default(0)
  losses    Int      @default(0)
  rating    Int      @default(1000)
  rank      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([rating(sort: Desc)])
  @@index([rank])
}

enum GameMode {
  SINGLE_PLAYER
  MULTIPLAYER
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
